# Скопируйте в keystore.properties и заполните (файл keystore.properties в git не попадает).
# Ключ создать: keytool -genkeypair -v -keystore phoneprint.jks -alias phoneprint -keyalg RSA -keysize 2048 -validity 10000
storeFile=phoneprint.jks
storePassword=CHANGE_ME
keyAlias=phoneprint
keyPassword=CHANGE_ME
