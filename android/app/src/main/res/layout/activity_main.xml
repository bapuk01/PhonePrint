<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Заголовок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Печать"
                    android:textColor="@color/text"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Подключение…"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Настройки"
                android:src="@drawable/ic_settings"
                android:tint="@color/muted" />
        </LinearLayout>

        <!-- Что печатать -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFiles"
                    style="@style/Btn.Primary"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_file"
                    android:drawablePadding="4dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:text="Файлы" />

                <Button
                    android:id="@+id/btnPhoto"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_camera"
                    android:drawablePadding="4dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:text="Фото" />
            </LinearLayout>

            <Button
                android:id="@+id/btnText"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Напечатать текст" />

            <LinearLayout
                android:id="@+id/queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Параметры -->
        <LinearLayout
            style="@style/Card"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Копии" />

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/Btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="−"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/copies"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/Btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="+"
                    android:textSize="22sp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/Label"
                    android:layout_marginEnd="12dp"
                    android:text="Страницы" />

                <EditText
                    android:id="@+id/pages"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:digits="0123456789,- "
                    android:gravity="center_vertical|end"
                    android:hint="все, напр. 1-3,5"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="16sp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/Label"
                    android:layout_marginEnd="12dp"
                    android:text="Принтер" />

                <Spinner
                    android:id="@+id/printer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnPrint"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:text="Печать"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="PDF, фото, Word, Excel, TXT · можно «Поделиться → Напечатать» из любого приложения"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Недавние"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
